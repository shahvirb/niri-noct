"window-rule"  {
  "clip-to-geometry" true
  "geometry-corner-radius" 6
}
"window-rule"  {
  "match" "app-id"="dev.noctalia.Noctalia"
  "default-column-width"  {
    "fixed" 1080
  }
  "default-window-height"  {
    "fixed" 920
  }
  "open-floating" true
}
"window-rule"  {
  "match" "app-id"="1password"
  "default-column-width"  {
    "fixed" 1000
  }
  "default-window-height"  {
    "fixed" 700
  }
  "open-floating" true
  "open-focused" true
}
"window-rule"  {
  "match" "app-id"="code"
  "open-focused" true
  "open-maximized" true
}
"window-rule"  {
  "match" "app-id"="com.mitchellh.ghostty"
  "background-effect"  {
    "blur" true
    "noise" 0.05
    "saturation" 3
    "xray" true
  }
  "default-column-width"  {
    "proportion" 0.5
  }
  "default-window-height"  {
    "proportion" 1.0
  }
  "draw-border-with-background" false
  "opacity" 0.85
  "open-floating" false
  "open-focused" true
  "scroll-factor" 3.0
}
"window-rule"  {
  "match" "app-id"="brave-browser"
  "default-column-width"  {
    "proportion" 0.5
  }
  "default-window-height"  {
    "proportion" 1.0
  }
  "open-floating" false
  "open-focused" true
}
"window-rule"  {
  "match" "app-id"="discord"
  "background-effect"  {
    "blur" true
    "noise" 0.05
    "saturation" 3
    "xray" true
  }
  "default-window-height"  {
    "proportion" 1.0
  }
  "draw-border-with-background" false
  "opacity" 0.85
  "open-floating" false
  "open-focused" true
}
"layer-rule"  {
  "match" "namespace"="^noctalia-wallpaper"
  "place-within-backdrop" true
}
"spawn-at-startup" "/nix/store/66r6li4qc325n917gq20mxd9kii0anv2-noctalia-5.2.1/bin/noctalia"
"output" "Dell Inc. DELL P2717H YKNFG82DA7XS" {
  "hot-corners"  {
    "off"  {

    }
  }
  "layout"  {
    "default-column-width"  {
      "proportion" 1.0
    }
  }
  "position" "x"=3072 "y"=0
  "scale" 1.0
  "transform" "270"
}
"output" "Dell Inc. DELL S3221QS 45JHB33" {
  "focus-at-startup"  {

  }
  "hot-corners"  {
    "off"  {

    }
  }
  "mode" "3840x2160@60.000"
  "position" "x"=0 "y"=0
  "scale" 1.25
}
"output" "eDP-1" {
  "scale" 1.75
}
